+        def fixed_phase(ids):
+            # Test injection exercises the normal reset path at recorded phases.
+            command.sampler.current_frames[ids] = phase
+            command.sampler.current_clip_indices[ids] = 0
+            command.sampler.current_clip_end_frames[ids] = 224
