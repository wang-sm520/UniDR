+# @package _global_
+# Single-backend baselines share policy I/O and the actual 29-DoF flip clip.
+defaults:
+  - /task/g1_flip_tracking/motrix
+  - _self_
+
+algo:
+  num_envs: 2048
+  empirical_normalization: false
+  algorithm:
+    disable_finite_checks: false
+
+env:
+  # Preserve the original baseline profile independently of native Motrix.
+  actions:
+    joint_pos:
+      scale: 0.25
+  scene:
+    entities:
+      robot:
+        # Tracking uses body states; these baselines do not query geometry.
+        geom_names: null
